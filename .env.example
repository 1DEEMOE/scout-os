# Local development only. Never commit real secrets.

# --- Database ---
# App role: no BYPASSRLS, owns no tables. Used by the web server and the worker.
DATABASE_URL=postgres://app_user:app_dev_pw@localhost:5432/wos_dev
# Owner role: migrations only. Never give this to the running app.
DATABASE_URL_OWNER=postgres://wos_owner:owner_dev_pw@localhost:5432/wos_dev
# Admin role: cross-tenant maintenance queries ONLY (routine reconciler,
# front-desk public-token lookup). FORCE RLS hides rows from every role, so
# these lookups need a role that owns the tables (RLS does not apply to table
# owners). Locally the postgres superuser is fine; in production use a
# dedicated role with no other grants. Without this the reconciler stays idle
# and public front-desk booking links 404.
DATABASE_URL_ADMIN=postgres://postgres@localhost:5432/wos_dev

# --- Auth ---
BETTER_AUTH_SECRET=replace-with-32+-random-characters
BETTER_AUTH_URL=http://localhost:3000

# --- Credential encryption (32 bytes, base64): openssl rand -base64 32 ---
# Losing this key makes stored integration credentials unreadable.
WOS_SECRETS_KEY=

# --- AI model ---
ANTHROPIC_API_KEY=
# MODEL_DEFAULT=claude-sonnet-5-5
# Set from your provider's current price list (USD per million tokens).
MODEL_PRICE_INPUT_USD_PER_MTOK=3
MODEL_PRICE_OUTPUT_USD_PER_MTOK=15

# --- Local demo without real services: MOCK model and MOCK tools, all labelled MOCK ---
# WOS_MOCK_MODE=1

# --- Gmail (OAuth client from Google Cloud) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Platform billing (your Stripe account, test mode first) ---
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=

# --- Background jobs ---
# Seconds between background inbox syncs per mailbox (minimum 30).
# WOS_INBOX_SYNC_SECONDS=300

# --- Observability ---
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
