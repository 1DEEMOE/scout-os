# Local development only. Never commit real secrets.

# --- Database ---
# App role: no BYPASSRLS, owns no tables. Used by the web server and the worker.
DATABASE_URL=postgres://app_user:app_dev_pw@localhost:5432/wos_dev
# Owner role: migrations only. Never give this to the running app.
DATABASE_URL_OWNER=postgres://wos_owner:owner_dev_pw@localhost:5432/wos_dev
# Admin role: the worker's lost-routine-run reconciler ONLY (cross-tenant scan).
# FORCE RLS applies to table owners too, so this needs a superuser or a role
# with BYPASSRLS. Never give it to the web process. Locally the postgres
# superuser is fine; in production use a dedicated BYPASSRLS role with no other
# grants, or leave it unset (the reconciler then stays idle and says so).
# Public booking links do NOT need it (migration 0019).
DATABASE_URL_ADMIN=postgres://postgres@localhost:5432/wos_dev

# --- Auth ---
BETTER_AUTH_SECRET=replace-with-32+-random-characters
BETTER_AUTH_URL=http://localhost:3000

# --- Credential encryption (32 bytes, base64): openssl rand -base64 32 ---
# Losing this key makes stored integration credentials unreadable.
WOS_SECRETS_KEY=

# --- AI model ---
ANTHROPIC_API_KEY=
# MODEL_DEFAULT=claude-sonnet-5-5
# Set from your provider's current price list (USD per million tokens).
MODEL_PRICE_INPUT_USD_PER_MTOK=3
MODEL_PRICE_OUTPUT_USD_PER_MTOK=15

# --- Local demo without real services: MOCK model and MOCK tools, all labelled MOCK ---
# WOS_MOCK_MODE=1

# --- Platform email (password resets, invitations) ---
# Any SMTP provider. Without these, email goes to the MOCK console sender:
# nothing is delivered and screens say so (invite links are shown to share).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Scout OS <no-reply@yourdomain.com>

# --- Gmail (OAuth client from Google Cloud) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Platform billing (your Stripe account, test mode first) ---
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=

# --- Background jobs ---
# Seconds between background inbox syncs per mailbox (minimum 30).
# WOS_INBOX_SYNC_SECONDS=300

# --- Public endpoints (booking links) ---
# Number of proxies in front of the app; the client IP used for rate limits is
# the N-th X-Forwarded-For entry from the right. 1 = Render's load balancer;
# 2 = Cloudflare in front of Render. 0 = ignore forwarded headers.
# WOS_TRUSTED_PROXY_HOPS=1

# --- Observability ---
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Plug and play (client workspaces) ---
# Who may create client workspaces at /admin/clients. Unset = nobody.
# Prefer user ids; emails count only once verified.
# WOS_PLATFORM_ADMIN_USER_IDS=
# WOS_PLATFORM_ADMIN_EMAILS=
# "Continue with Google" on the invite page (reuses GOOGLE_CLIENT_ID/SECRET;
# add <BETTER_AUTH_URL>/api/auth/callback/google to the client's redirect URIs).
# WOS_GOOGLE_SIGNIN=1
